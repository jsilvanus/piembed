[Unit]
Description=PiEmbed Semantic Vector Matching Engine
After=network-online.target

[Service]
WorkingDirectory=%h/apps/piembed
EnvironmentFile=%h/apps/piembed.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node dist/main.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
