{
  "name": "piembed",
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "description": "Vector embedding and semantic cue matching microservice for the Raspberry Pi production ecosystem",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.3.3",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist"
  ],
  "pi": {
    "service": "piembed",
    "displayName": "PiEmbed",
    "layer": "Layer 3: Semantic Vector Engine",
    "port": 3125,
    "ports": {},
    "healthEndpoint": "/health",
    "envPortVar": "PIEMBED_PORT"
  }
}
