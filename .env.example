# piembed configuration
PIEMBED_PORT=3125
PIEMBED_HOST=0.0.0.0

# Remote Ollama configuration (default primary provider on adjacent machine)
PIEMBED_OLLAMA_URL=http://127.0.0.1:11434
PIEMBED_OLLAMA_MODEL=bge-m3:latest
PIEMBED_OLLAMA_TIMEOUT_MS=2500
PIEMBED_HEALTH_CHECK_INTERVAL_MS=15000

# In-process Hugging Face Transformers fallback configuration
PIEMBED_INPROCESS_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
PIEMBED_INPROCESS_QUANTIZED=true
PIEMBED_MODEL_CACHE_DIR=./.cache/models

# Semantic matching defaults
PIEMBED_DEFAULT_THRESHOLD=0.70
PIEMBED_LRU_MAX_ENTRIES=2000
